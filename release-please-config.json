{
  "packages": {
    ".": {
      "release-type": "simple",
      "changelog-path": "docs/CHANGELOG.md",
      "include-v-in-tag": true,
      "initial-version": "1.1.0",
      "include-component-in-tag": false,
      "extra-files": [
        {
          "type": "pom",
          "path": "backend/pom.xml"
        },
        {
          "type": "json",
          "path": "frontend/package.json",
          "jsonpath": "$.version"
        }
      ]
    }
  }
}
